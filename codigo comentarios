def registrar_comentario():
 texto = input("Escriba el comentario: ").strip()
 if texto != "":
  comentarios.append(texto)
  print("Comentario registrado.")
 else:
  print("El comentario no puede estar vacio.")

def mostrar_comentarios():
   if len(comentarios) == 0:
      print("No hay comentarios registrados.")
   else:
        print("Comentarios")
        for i in range(len(comentarios)):
            print(i + 1, comentarios[i])

def buscar_comentario():  
    buscartexto = input("Que comentario desea buscar: ").strip().lower()
    encontrado = False
    
    for c in comentarios:
        if buscartexto in c.lower():
            print(f"Se encontró el comentario: '{c}'")
            encontrado = True
            
    if not encontrado:
        print("No se encontró ningún comentario relacionado.")

